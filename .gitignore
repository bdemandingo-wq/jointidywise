# Environment variables (never commit these)
.env
.env.*
!.env.example
!.env.test.example

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Deno (used by scripts/render-payroll-preview.ts)
deno.lock

# Local email preview output (repo root only — an unanchored `preview/` also
# matches src/pages/preview/, which silently excluded a real source file)
/preview/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
supabase/.temp/

# Capacitor Android scaffold — auto-generated by `npx cap add android`.
# Not committed because we ship iOS-first; regenerate when an Android
# build is actually needed.
android/

# Playwright output
/screenshots/
/test-results/
/playwright-report/
/qa-report/
/tests/.auth/
e2e/artifacts

# Scratch DB dumps dropped at repo root during investigation/debugging
# (e.g. DDL extracts pasted from Lovable's SQL runner) — not source,
# never meant to be committed. Root-only so this doesn't catch real
# migration files under supabase/migrations/.
/*.sql
/*.txt

# Mockup binaries — the HTML in design/mockups/ is the source of truth for
# measurements and is tracked; the 62MB of PNGs and the zip are not.
design/mockups/png/
design/mockups/*.zip
