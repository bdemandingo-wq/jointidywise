<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
        <string>TidyWise</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>TidyWise shares your location with your business and its customer only during an On My Way trip, so they know when you'll arrive. It stops when you arrive or the job starts. Location is also recorded when you clock in or out and take job photos.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>TidyWise shares your location with your business and its customer only during an On My Way trip, including when the app is closed or your phone is locked, so they know when you'll arrive. It stops when you arrive or the job starts. Location is also recorded when you clock in or out and take job photos.</string>
	<key>NSCameraUsageDescription</key>
	<string>TidyWise needs camera access to take before/after photos for cleaning jobs.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>TidyWise needs photo library access to attach existing photos to job and inspection reports.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>TidyWise saves job photos and exported files to your photo library.</string>
	<!--
	  Background modes: fetch, remote push, and location.
	  location is used only during an active On My Way trip.
	  TripBackgroundLocationPlugin starts CLLocationManager when that trip
	  starts and stops it on arrival, when the job starts, or when tracking
	  stops. showsBackgroundLocationIndicator is on, so iOS shows the blue
	  location pill while the watcher is running. The usage strings stay the
	  legal disclosure: shared during On My Way, and recorded at clock in/out
	  and job photos.
	-->
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>remote-notification</string>
		<string>location</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>Google OAuth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.508777160782-h9u2n2trq255humf1sigl88t0a38peb4</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleURLName</key>
			<string>App OAuth Callback</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.TidyWiseApp.app</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleURLName</key>
			<string>Widget Deep Link</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>tidywise</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
