<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
        <string>TidyWise</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>TidyWise uses your location while the app is open to share your ETA with your company's admins after you tap On My Way, and to record where job photos are taken.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>TidyWise uses your location while the app is open to share your ETA with your company's admins after you tap On My Way, and to record where job photos are taken.</string>
	<key>NSCameraUsageDescription</key>
	<string>TidyWise needs camera access to take before/after photos for cleaning jobs.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>TidyWise needs photo library access to attach existing photos to job and inspection reports.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>TidyWise saves job photos and exported files to your photo library.</string>
	<!--
	  Background modes match what the app actually does: background fetch, and
	  remote push. `location` is intentionally absent. @capacitor/geolocation
	  does not run a continuous background session, and declaring the location
	  background mode was removed for App Store guideline 2.5.4. Live tracking
	  runs while the app is open and catches up when the cleaner returns.
	  NSLocationAlwaysAndWhenInUseUsageDescription is required by the Capacitor
	  geolocation plugin even though the prompt itself is When In Use.
	-->
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>remote-notification</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>Google OAuth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.508777160782-h9u2n2trq255humf1sigl88t0a38peb4</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleURLName</key>
			<string>App OAuth Callback</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.TidyWiseApp.app</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleURLName</key>
			<string>Widget Deep Link</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>tidywise</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
